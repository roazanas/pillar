{
  "name": "pillar-language", "displayName": "Pillar",
  "description": "Pillar diagnostics, navigation, formatting and vertical column editing.",
  "version": "0.1.0", "publisher": "pillar-language", "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/roazanas/pillar" },
  "engines": { "vscode": "^1.91.0" }, "categories": ["Programming Languages"],
  "main": "./extension.js", "activationEvents": ["onLanguage:pillar"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": {
    "languages": [{ "id": "pillar", "aliases": ["Pillar"], "extensions": [".plr"] }],
    "configuration": { "title": "Pillar", "properties": {
      "pillar.compilerPath": { "type": "string", "default": "plrc", "description": "Path to the Pillar compiler. Reload the window after changing it.", "scope": "machine" }
    } },
    "commands": [
      { "command": "pillar.insertDownward", "title": "Pillar: Insert text downward" },
      { "command": "pillar.insertColumn", "title": "Pillar: Insert column" },
      { "command": "pillar.removeColumn", "title": "Pillar: Remove column" },
      { "command": "pillar.moveColumnLeft", "title": "Pillar: Move column left" },
      { "command": "pillar.moveColumnRight", "title": "Pillar: Move column right" },
      { "command": "pillar.preview", "title": "Pillar: Open horizontal preview" }
    ],
    "keybindings": [{ "command": "pillar.insertDownward", "key": "ctrl+alt+enter", "mac": "cmd+alt+enter", "when": "editorTextFocus && editorLangId == pillar" }]
  },
  "scripts": { "check": "node --check extension.js", "test": "node --test ../columns.test.js" },
  "dependencies": { "vscode-languageclient": "^11.0.0" }
}
